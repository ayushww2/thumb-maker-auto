generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Channel {
  id           String  @id @default(cuid())
  handle       String  @unique
  channelId    String?
  name         String
  url          String
  videoCount   Int     @default(0)
  videos       Video[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Video {
  id              String   @id @default(cuid())
  youtubeId       String   @unique
  title           String
  viewCount       Int
  thumbnailUrl    String
  thumbnailUrlHq  String?
  r2Key           String?
  r2ThumbnailUrl  String?
  videoUrl        String
  durationSeconds Int?
  uploadDate      String?
  channelId       String
  channel         Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  thumbScan       ThumbScan?
  indexedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([viewCount])
  @@index([title])
  @@index([channelId, viewCount])
  @@index([r2ThumbnailUrl])
}

/// Mystery Thumb Agent visual + title lesson for one competitor video
model ThumbScan {
  id            String   @id @default(cuid())
  videoId       String   @unique
  video         Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tier          String // viral | mid | low
  subject       String?
  composition   String?
  colors        String?
  overlayText   String?
  emotionalHook String?
  formatLabel   String?
  whyItWorks    String?
  rawNotes      String
  model         String
  scannedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tier])
}

model AgentPlaybook {
  id               String   @id @default("mystery-thumb-agent")
  agent            String   @default("mystery-thumb-agent")
  summary          String
  viralPatterns    Json
  lowViewPatterns  Json
  thumbnailFormats Json
  titleFormulas    Json
  doList           Json
  dontList         Json
  viralThreshold   Int
  lowThreshold     Int
  sampleSize       Int
  viralCount       Int
  lowCount         Int
  scanCount        Int      @default(0)
  r2Key            String?
  r2Url            String?
  generatedAt      DateTime
  updatedAt        DateTime @updatedAt
}

/// Background Mystery Thumb Agent generation job
model Job {
  id              String    @id @default(cuid())
  title           String
  notes           String?
  status          String    @default("queued") // queued | running | completed | failed
  progress        String    @default("Queued")
  error           String?
  useAgent        Boolean   @default(true)
  prompt          String?
  analysis        String?
  chosenFormat    String?
  overlayText     String?
  whyTheseComps   String?
  playbookSummary String?
  competitorsJson Json?
  imageR2Key      String?
  imageUrl        String?
  imageBytes      Int?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}
