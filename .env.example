# ContactBoxTools (OpenAI-compatible) — primary provider
CONTACTBOX_API_KEY=
CONTACTBOX_BASE_URL=https://api.contactboxtools.me/v1
CONTACTBOX_REASONING_MODEL=gpt-5.5
CONTACTBOX_IMAGE_MODEL=gpt-image-2
CONTACTBOX_IMAGE_QUALITY=high
CONTACTBOX_IMAGE_SIZE=1280x720

# Optional fallback if ContactBox key/group is unavailable
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thumb_maker

# Optional seed guard for POST /api/collection/seed
COLLECTION_SEED_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=autothumb
R2_ENDPOINT=
R2_PUBLIC_URL=https://pub-c25f40bdebfb4d9cb7c2539a01c0854d.r2.dev
